{
  "scripts": {
    "dev": "concurrently -k -n FRONT,BACK -c blue,red \"npm:dev:front\" \"npm:dev:back\"",
    "dev:front": "npm --prefix frontend run dev",
    "dev:back": "python -m uvicorn app.main:app --app-dir backend --reload --host 127.0.0.1 --port 8000",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19"
  }
}
