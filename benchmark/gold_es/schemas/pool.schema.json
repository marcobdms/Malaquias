{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malaquias.local/schemas/gold-es/pool.schema.json",
  "title": "Pool cerrado de candidatos para una vacante",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "split", "frozen_at", "candidates"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_id": { "type": "string", "minLength": 1 },
    "split": { "enum": ["calibration", "holdout"] },
    "frozen_at": { "type": "string", "format": "date-time" },
    "pool_version": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "source_record_id", "selection_bucket"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "source_record_id": { "type": "string", "minLength": 1 },
          "selection_bucket": { "enum": ["plausible_positive", "partial", "hard_negative", "easy_negative", "unknown"] },
          "hard_negative_types": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["adjacent_role", "missing_required", "seniority_mismatch", "sector_mismatch", "keyword_only", "manager_vs_hands_on", "near_positive"] },
            "default": []
          },
          "selection_notes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
