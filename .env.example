# Backend
# Producción: usa una URI PostgreSQL administrada. No apuntes el benchmark a producción.
DATABASE_URL=postgresql://usuario:password@host:5432/malaquias
SECRET_KEY=reemplazar_por_una_clave_larga_y_aleatoria
# Explicaciones opcionales. El ranking funciona aunque no configures un LLM.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# LLM_MAX_ATTEMPTS=3
# LLM_TIMEOUT_SECONDS=30
# LLM_MIN_INTERVAL_SECONDS=0
# Caché efímera en memoria y desactivada por defecto (los CV contienen datos personales).
# LLM_CACHE_TTL_SECONDS=0

# Email transaccional opcional para confirmaciones futuras.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Malaquias <onboarding@resend.dev>
FRONTEND_URL=https://tu-dominio.example

# Desarrollo local recomendado en .env.local (archivo ignorado por Git):
# DATABASE_URL=sqlite:///./backend/malaquias_local.db
